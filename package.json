		"@types/d3-shape": "^3.1.8",
		"@types/node": "^26.1.1",
		"@types/nodemailer": "^8.0.1",
		"@vitest/browser": "^4.1.10",
		"better-auth": "1.7.0-rc.1",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
