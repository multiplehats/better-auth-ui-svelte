{
	"name": "better-auth-ui-svelte",
	"version": "0.13.1",
	"description": "Pre-built authentication UI components for Better Auth in Svelte 5",
	"scripts": {
		"dev": "vite dev",
		"prebuild": "tsx scripts/prebuild.ts",
		"postbuild": "tsx scripts/postbuild.ts",
		"build": "pnpm run prebuild && vite build && npm run prepack && pnpm run postbuild",
		"ci:publish": "pnpm prepack && changeset publish",
		"preview": "vite preview",
		"sync": "svelte-kit sync",
		"prepare": "pnpm run sync || echo ''",
		"prepack": "pnpm run sync && pnpm run prebuild && svelte-package && cp src/lib/style.css dist/style.css && publint && pnpm run postbuild",
		"check": "pnpm run sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "pnpm run sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"lint": "eslint . && prettier --check .",
		"format": "prettier --write .",
		"docker:up": "docker-compose -f ./compose.yaml up -d",
		"docker:down": "docker-compose -f ./compose.yaml down",
		"docker:destroy": "docker-compose -f ./compose.yaml down -v",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		"./css": "./dist/style.css",
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"@better-auth/api-key": "^1.7.0-rc.1",
		"@better-auth/passkey": "^1.7.0-rc.1",
		"@lucide/svelte": "^1.0.0",
		"@noble/hashes": "^2.0.1",
		"@sveltejs/kit": "^2.0.0",
		"better-auth": "^1.7.0-rc.1",
		"bits-ui": "^2.14.4",
		"d3-scale": "^4.0.2",
		"d3-shape": "^3.2.0",
		"layerchart": "^2.0.0",
		"svelte": "^5.0.0",
		"tailwindcss": "^4.0.0",
		"zod": "^4.0.0"
	},
	"peerDependenciesMeta": {
		"@better-auth/api-key": {
			"optional": true
		}
	},
	"devDependencies": {
		"@better-auth/api-key": "1.7.0-rc.1",
		"@better-auth/passkey": "1.7.0-rc.1",
		"@changesets/cli": "^2.31.1",
		"@dnd-kit-svelte/svelte": "^0.1.6",
		"@dnd-kit/abstract": "^0.5.0",
		"@dnd-kit/helpers": "^0.5.0",
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.2",
		"@lucide/svelte": "^1.25.0",
		"@noble/hashes": "^2.2.0",
		"@playwright/test": "^1.61.1",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@svitejs/changesets-changelog-github-compact": "^1.2.0",
		"@tabler/icons-svelte": "^3.45.0",
