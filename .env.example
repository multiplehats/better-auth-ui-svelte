# Optional: Leave empty for Mailpit
SMTP_USER=
SMTP_PASS=

# Google client ID and secret for OAuth (if using Google login)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
