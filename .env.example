DATABASE_URL="postgres://root:secret@localhost:5434/local"
BETTER_AUTH_SECRET="your_better_auth_secret_here"
BETTER_AUTH_URL=http://localhost:5173

# Email Configuration (Mailpit for development)
SMTP_HOST=localhost
SMTP_PORT=1025
